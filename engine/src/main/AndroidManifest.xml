<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Camera permission — required for ARCore and MediaPipe -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ARCore: marks AR as optional so the app installs on non-AR devices -->
    <!-- DeviceCapabilityChecker.kt handles the runtime fallback -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application>
        <!-- ARCore optional — engine handles install flow in ArInstallFlow.kt -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />
    </application>

</manifest>
