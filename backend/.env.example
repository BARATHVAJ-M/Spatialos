# PostgreSQL Database Connection URL Template
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/spatialos?schema=public"

# Application Settings
PORT=3000
NODE_ENV=development
JWT_SECRET="replace_with_a_long_secure_random_string"
STORAGE_ROOT="./storage"
ALLOWED_ORIGINS="https://localhost:3000"

# Bootstrap Admin Configuration (Local & Init Setup Only)
BOOTSTRAP_ADMIN_EMAIL="admin@yourdomain.com"
BOOTSTRAP_ADMIN_PASSWORD="replace_with_secure_bootstrap_password"
