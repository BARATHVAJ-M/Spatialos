# PostgreSQL Database Connection URL
# Replace 'postgres:postgres' with your local PostgreSQL username and password
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/spatialos?schema=public"

# Application Settings
PORT=3001
NODE_ENV=development
JWT_SECRET="spatialos-prototype-super-secret-jwt-key-2026"
STORAGE_ROOT="./storage"
STORAGE_DESTINATION="./storage"

# Default Admin Credentials (Auto-created on first server bootstrap)
# Email: admin@spatialos.com
# Password: admin123
BOOTSTRAP_ADMIN_EMAIL="admin@spatialos.com"
BOOTSTRAP_ADMIN_PASSWORD="admin123"
